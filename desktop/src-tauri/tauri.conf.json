{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Geogematria Desktop Gate",
  "version": "0.1.0",
  "identifier": "org.geogematria.desktop-gate",
  "build": { "frontendDist": "../frontend/dist", "beforeBuildCommand": "node build.mjs" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Geogematria · renderer / owned-engine gate", "width": 1180, "height": 820, "minWidth": 480, "minHeight": 500 }],
    "security": { "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://tile.openstreetmap.org; img-src 'self' data: blob: https://tile.openstreetmap.org; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; script-src 'self'" }
  },
  "bundle": { "active": true, "targets": ["deb"], "resources": { "../sidecar/dist/geogematria-engine/": "engine/" }, "category": "Utility", "shortDescription": "Bounded geogematria renderer/lifecycle gate" }
}
