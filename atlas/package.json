{
  "name": "geogematria-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-data.mjs --target=full",
    "dev": "vite --host 127.0.0.1",
    "dev:public": "node scripts/build-data.mjs --target=public && vite --host 127.0.0.1 --mode public",
    "prebuild": "node scripts/build-data.mjs --target=full",
    "build": "vite build",
    "build:public": "node scripts/build-data.mjs --target=public && vite build --mode public",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "maplibre-gl": "^4.7.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "vite": "^5.4.0"
  }
}
